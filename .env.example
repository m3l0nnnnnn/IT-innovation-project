# Copy this file to .env and fill in the real values. Never commit .env.

# Supabase Postgres via the Session pooler (Supabase dashboard → Connect → Session pooler).
# Replace YOUR_PASSWORD with the real password — no square brackets.
# Percent-encode special characters in the password (e.g. @ → %40, # → %23).
DATABASE_URL=postgresql://postgres.mazjfcbhnxqmgadwklel:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase CA certificate, used to verify the database's SSL certificate.
DATABASE_CA_CERT=certs/prod-ca-2021.crt
